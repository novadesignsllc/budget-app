{
  "expo": {
    "name": "Slip",
    "slug": "zero-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zerobudget",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.davewilson.zerobudget",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Slip turns what you say, like “McDonald’s 10.99”, into a transaction.",
        "NSMicrophoneUsageDescription": "Slip uses the microphone so you can say a transaction instead of typing it.",
        "NSPhotoLibraryUsageDescription": "Slip doesn’t use your photos. A library it includes can load images from the photo library, and Apple asks every app with that code to say so.",
        "NSCameraUsageDescription": "Slip doesn’t use the camera. Plaid, which signs in to your bank, includes code that can, and Apple asks every app with that code to say so."
      },
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15122E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.davewilson.zerobudget",
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": {
        "policy": "fingerprint"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          },
          "android": {
            "kotlinVersion": "2.3.0"
          }
        }
      ],
      "expo-apple-authentication",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Slip uses the microphone so you can say a transaction instead of typing it.",
          "speechRecognitionPermission": "Slip turns what you say, like “McDonald’s 10.99”, into a transaction."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bf90fb8c-48ba-478b-9e47-8f83824c4b69"
      }
    },
    "owner": "lldavell",
    "updates": {
      "url": "https://u.expo.dev/bf90fb8c-48ba-478b-9e47-8f83824c4b69"
    }
  }
}
